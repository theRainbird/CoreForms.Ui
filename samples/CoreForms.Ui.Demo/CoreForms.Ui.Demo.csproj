<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CoreForms.Ui.Demo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoreForms.Ui\CoreForms.Ui.csproj" />
    <ProjectReference Include="..\..\src\CoreForms.Ui.WebBrowser\CoreForms.Ui.WebBrowser.csproj" />
    <ProjectReference Include="..\..\src\CoreForms.Ui.WebBrowser.Helper\CoreForms.Ui.WebBrowser.Helper.csproj" ReferenceOutputAssembly="false" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <Target Name="CopyHelper" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <ItemGroup>
      <_HelperFiles Include="..\..\src\CoreForms.Ui.WebBrowser.Helper\bin\$(Configuration)\net10.0\CoreForms.Ui.WebBrowser.Helper*" />
      <_HelperFiles Include="..\..\src\CoreForms.Ui.WebBrowser.Helper\bin\$(Configuration)\net10.0\WebBrowserHelper*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HelperFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
