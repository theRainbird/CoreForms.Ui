<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Compile the native C WebKit helper -->
  <Target Name="CompileNativeHelper" BeforeTargets="Build">
    <Exec Command="/bin/bash -c 'gcc -o &quot;$(TargetDir)WebBrowserHelper&quot; &quot;$(MSBuildProjectDirectory)/helper.c&quot; `pkg-config --cflags --libs gtk+-3.0 webkit2gtk-4.1`'" />
  </Target>

</Project>
