<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OldSchoolForms.Ui</RootNamespace>
    <AssemblyName>OldSchoolForms.Ui</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <Authors>Hagen Siegel</Authors>
    <Description>A classic forms UI library for Linux and Windows</Description>
    <Copyright>Copyright 2026 Hagen Siegel</Copyright>
    <PackageProjectUrl>https://github.com/theRainbird/OldSchoolForms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/theRainbird/OldSchoolForms.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>UI, Forms, WinForms, Linux, Controls</PackageTags>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseUrl>https://github.com/theRainbird/OldSchoolForms/blob/silk/LICENSE</PackageLicenseUrl>
    <PackageIcon>OldSchoolForms-NuGetIcon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Icons/*.svg" />
    <EmbeddedResource Include="Resources/Icons/FluentColor/*.svg" />
    <EmbeddedResource Include="Resources/Icons/SvgRepo/*.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)Resources/Icons/OldSchoolForms-NuGetIcon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OldSchoolForms.Ui.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
    <PackageReference Include="Svg.Skia" Version="4.6.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
  </ItemGroup>

</Project>